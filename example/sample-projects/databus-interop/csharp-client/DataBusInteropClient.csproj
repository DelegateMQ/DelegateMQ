<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>databus_interop_csharp_client</AssemblyName>
  </PropertyGroup>

  <!-- MessagePack serialization library -->
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <!-- Shared interop library files from interop/csharp/ -->
  <ItemGroup>
    <Compile Include="../../../../interop/csharp/DmqDataBus.cs" />
    <Compile Include="../../../../interop/csharp/Serializer.cs" />
  </ItemGroup>

  <!-- Native interop core (build interop/native first), copied next to the executable -->
  <ItemGroup>
    <None Include="../../../../interop/native/build/bin/Release/DmqInterop.dll" Condition="Exists('../../../../interop/native/build/bin/Release/DmqInterop.dll')">
      <Link>DmqInterop.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../../../interop/native/build/bin/Debug/DmqInterop.dll" Condition="!Exists('../../../../interop/native/build/bin/Release/DmqInterop.dll') And Exists('../../../../interop/native/build/bin/Debug/DmqInterop.dll')">
      <Link>DmqInterop.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Linux: single-config generators build straight into build/lib. -->
    <None Include="../../../../interop/native/build/lib/libDmqInterop.so" Condition="Exists('../../../../interop/native/build/lib/libDmqInterop.so')">
      <Link>libDmqInterop.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
