{
  "name": "DelegateMQ",
  "version": "3.0.0",
  "description": "C++17 delegates, signals and async messaging for embedded and desktop. Sync/async/remote function calls across threads, processes and CPUs; DataBus pub/sub; FreeRTOS, ThreadX, Zephyr, CMSIS-RTOS2, NuttX and bare-metal ports; no heap option.",
  "keywords": [
    "delegate",
    "signal slot",
    "async",
    "messaging",
    "publish subscribe",
    "rtos",
    "freertos",
    "zephyr",
    "esp32",
    "stm32",
    "signals",
    "events",
    "embedded",
    "cpp17"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DelegateMQ/DelegateMQ.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/DelegateMQ/DelegateMQ",
  "frameworks": "*",
  "platforms": [
    "espressif32",
    "ststm32",
    "raspberrypi",
    "native"
  ],
  "headers": "DelegateMQ.h",
  "export": {
    "include": [
      "src",
      "docs",
      "example/platformio",
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "library.json"
    ],
    "exclude": [
      "example/platformio/**/.pio",
      "**/.gitignore"
    ]
  },
  "build": {
    "srcDir": "src/delegate-mq",
    "includeDir": "src/delegate-mq",
    "flags": [
      "-std=gnu++17",
      "-Wno-psabi"
    ],
    "unflags": [
      "-std=gnu++11",
      "-std=gnu++14",
      "-std=c++11",
      "-std=c++14"
    ]
  },
  "examples": [
    {
      "name": "async-delegates",
      "base": "example/platformio/async-delegates",
      "files": [
        "platformio.ini",
        "freertos_path.py",
        "include/DelegateMQConfig.h",
        "src/main.cpp"
      ]
    }
  ]
}
